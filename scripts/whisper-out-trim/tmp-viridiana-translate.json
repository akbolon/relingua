s": [50464, 708, 257, 1481, 1081, 11, 463, 6, 335, 13, 50564], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 45, "seek": 14392, "start": 147.92, "end": 149.92, "text": " It's going to look like you're still in the convent.", "tokens": [50564, 467, 311, 516, 281, 574, 411, 291, 434, 920, 294, 264, 416, 2475, 13, 50664], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 46, "seek": 14392, "start": 149.92, "end": 153.92, "text": " Well, how much are you going to rent?", "tokens": [50664, 1042, 11, 577, 709, 366, 291, 516, 281, 6214, 30, 50864], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 47, "seek": 14392, "start": 153.92, "end": 155.92, "text": " Very little, ma'am.", "tokens": [50864, 4372, 707, 11, 463, 6, 335, 13, 50964], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 48, "seek": 14392, "start": 155.92, "end": 157.92, "text": " I only have permission for a few days.", "tokens": [50964, 286, 787, 362, 11226, 337, 257, 1326, 1708, 13, 51064], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 49, "seek": 14392, "start": 157.92, "end": 159.92, "text": " Did you spend a lot of time getting it?", "tokens": [51064, 2589, 291, 3496, 257, 688, 295, 565, 1242, 309, 30, 51164], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 50, "seek": 14392, "start": 159.92, "end": 161.92, "text": " No.", "tokens": [51164, 883, 13, 51264], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 51, "seek": 14392, "start": 161.92, "end": 163.92, "text": " I came for orders from the superior.", "tokens": [51264, 286, 1361, 337, 9470, 490, 264, 13028, 13, 51364], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 52, "seek": 14392, "start": 163.92, "end": 167.92, "text": " I was not interested in seeing what you had to order.", "tokens": [51364, 286, 390, 406, 3102, 294, 2577, 437, 291, 632, 281, 1668, 13, 51564], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 53, "seek": 14392, "start": 167.92, "end": 169.92, "text": " The truth is not much.", "tokens": [51564, 440, 3494, 307, 406, 709, 13, 51664], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 54, "seek": 14392, "start": 169.92, "end": 171.92, "text": " I'm not going to lie, ma'am.", "tokens": [51664, 286, 478, 406, 516, 281, 4544, 11, 463, 6, 335, 13, 51764], "temperature": 0.0, "avg_logprob": -0.3815319031242311, "compression_ratio": 1.6077586206896552, "no_speech_prob": 0.0007424238719977438}, {"id": 55, "seek": 17192, "start": 171.92, "end": 173.92, "text": " I respect and thank you for the matter.", "tokens": [50364, 286, 3104, 293, 1309, 291, 337, 264, 1871, 13, 50464], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 56, "seek": 17192, "start": 173.92, "end": 175.92, "text": " I owe it to you.", "tokens": [50464, 286, 16655, 309, 281, 291, 13, 50564], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 57, "seek": 17192, "start": 175.92, "end": 177.92, "text": " But no one else.", "tokens": [50564, 583, 572, 472, 1646, 13, 50664], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 58, "seek": 17192, "start": 177.92, "end": 179.92, "text": " No one.", "tokens": [50664, 883, 472, 13, 50764], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 59, "seek": 17192, "start": 179.92, "end": 181.92, "text": " You're right.", "tokens": [50764, 509, 434, 558, 13, 50864], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 60, "seek": 17192, "start": 181.92, "end": 183.92, "text": " The loneliness has come back to me.", "tokens": [50864, 440, 28144, 575, 808, 646, 281, 385, 13, 50964], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 61, "seek": 17192, "start": 183.92, "end": 185.92, "text": " Now I feel we've had a lot more time.", "tokens": [50964, 823, 286, 841, 321, 600, 632, 257, 688, 544, 565, 13, 51064], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 62, "seek": 17192, "start": 185.92, "end": 187.92, "text": " Too late, right?", "tokens": [51064, 11395, 3469, 11, 558, 30, 51164], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 63, "seek": 17192, "start": 187.92, "end": 189.92, "text": " Yes.", "tokens": [51164, 1079, 13, 51264], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 64, "seek": 17192, "start": 189.92, "end": 191.92, "text": " Too late.", "tokens": [51264, 11395, 3469, 13, 51364], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 65, "seek": 17192, "start": 191.92, "end": 193.92, "text": " You're not very abandoned in the fields, ma'am.", "tokens": [51364, 509, 434, 406, 588, 13732, 294, 264, 7909, 11, 463, 6, 335, 13, 51464], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 66, "seek": 17192, "start": 193.92, "end": 195.92, "text": " It's been 20 years since you've done all this.", "tokens": [51464, 467, 311, 668, 945, 924, 1670, 291, 600, 1096, 439, 341, 13, 51564], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 67, "seek": 17192, "start": 195.92, "end": 199.92, "text": " And at home, apart from the first floor,", "tokens": [51564, 400, 412, 1280, 11, 4936, 490, 264, 700, 4123, 11, 51764], "temperature": 0.0, "avg_logprob": -0.5259661634429162, "compression_ratio": 1.518018018018018, "no_speech_prob": 0.012511562556028366}, {"id": 68, "seek": 19992, "start": 199.92, "end": 201.92, "text": " you produce very well the spiders.", "tokens": [50364, 291, 5258, 588, 731, 264, 32171, 13, 50464], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 69, "seek": 19992, "start": 201.92, "end": 203.92, "text": " As soon as you get to the field.", "tokens": [50464, 1018, 2321, 382, 291, 483, 281, 264, 2519, 13, 50564], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 70, "seek": 19992, "start": 203.92, "end": 205.92, "text": " It's true.", "tokens": [50564, 467, 311, 2074, 13, 50664], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 71, "seek": 19992, "start": 205.92, "end": 207.92, "text": " And when you get out, I'm going to jump.", "tokens": [50664, 400, 562, 291, 483, 484, 11, 286, 478, 516, 281, 3012, 13, 50764], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 72, "seek": 19992, "start": 207.92, "end": 209.92, "text": " Come here, Perrito.", "tokens": [50764, 2492, 510, 11, 3026, 17492, 13, 50864], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 73, "seek": 19992, "start": 209.92, "end": 211.92, "text": " Who is it?", "tokens": [50864, 2102, 307, 309, 30, 50964], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 74, "seek": 19992, "start": 211.92, "end": 213.92, "text": " It's the daughter of Ramona, my servant.", "tokens": [50964, 467, 311, 264, 4653, 295, 9078, 4037, 11, 452, 17896, 13, 51064], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 75, "seek": 19992, "start": 213.92, "end": 214.92, "text": " Come on.", "tokens": [51064, 2492, 322, 13, 51114], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 76, "seek": 19992, "start": 214.92, "end": 216.92, "text": " She's made a jump.", "tokens": [51114, 1240, 311, 1027, 257, 3012, 13, 51214], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 77, "seek": 19992, "start": 216.92, "end": 218.92, "text": " How do you think about your aunt?", "tokens": [51214, 1012, 360, 291, 519, 466, 428, 15654, 30, 51314], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 78, "seek": 19992, "start": 218.92, "end": 220.92, "text": " Until the same way of giving birth.", "tokens": [51314, 9088, 264, 912, 636, 295, 2902, 3965, 13, 51414], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 79, "seek": 19992, "start": 220.92, "end": 222.92, "text": " I know, ma'am.", "tokens": [51414, 286, 458, 11, 463, 6, 335, 13, 51514], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 80, "seek": 19992, "start": 222.92, "end": 223.92, "text": " I've told you before.", "tokens": [51514, 286, 600, 1907, 291, 949, 13, 51564], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 81, "seek": 19992, "start": 223.92, "end": 225.92, "text": " You see it, and your voice too.", "tokens": [51564, 509, 536, 309, 11, 293, 428, 3177, 886, 13, 51664], "temperature": 0.0, "avg_logprob": -0.44073989040167755, "compression_ratio": 1.510548523206751, "no_speech_prob": 0.007128753233700991}, {"id": 82, "seek": 22992, "start": 229.92, "end": 231.92, "text": " Come on.", "tokens": [50364, 2492, 322, 13, 50464], "temperature": 0.0, "avg_logprob": -0.23307921281501429, "compression_ratio": 5.8, "no_speech_prob": 0.8707717061042786}, {"id": 83, "seek": 22992, "start": 231.92, "end": 233.92, "text": " Come on.", "tokens": [50464, 2492, 322, 13, 50564], "temperature": 0.0, "avg_logprob": -0.23307921281501429, "compression_ratio": 5.8, "no_speech_prob": 0.8707717061042786}, {"id": 84, "seek": 22992, "start": 233.92, "end": 235.92, "text": " Come on.", "tokens": [50564, 2492, 322, 13, 50664], "temperature": 0.0, "avg_logprob": -0.23307921281501429, "compression_ratio": 5.8, "no_s