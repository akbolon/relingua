": " Pero en lo dem\u00e1s...", "tokens": [51164, 9377, 465, 450, 34682, 485, 51214], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 43, "seek": 15900, "start": 176.0, "end": 178.0, "text": " Ning\u00fan calor humano.", "tokens": [51214, 39417, 9453, 31575, 30985, 13, 51314], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 44, "seek": 15900, "start": 178.0, "end": 179.0, "text": " Ninguno.", "tokens": [51314, 39417, 12638, 13, 51364], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 45, "seek": 15900, "start": 179.0, "end": 180.0, "text": " Tiene raz\u00f3n.", "tokens": [51364, 314, 10174, 38310, 13, 51414], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 46, "seek": 15900, "start": 180.0, "end": 182.0, "text": " La soledad me ha vuelto ego\u00edsta.", "tokens": [51414, 2369, 1404, 292, 345, 385, 324, 20126, 1353, 14495, 870, 9140, 13, 51514], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 47, "seek": 15900, "start": 182.0, "end": 185.0, "text": " Ahora siento que no hayamos tenido m\u00e1s trato.", "tokens": [51514, 18840, 40340, 631, 572, 4842, 2151, 33104, 3573, 504, 2513, 13, 51664], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 48, "seek": 15900, "start": 185.0, "end": 187.0, "text": " Demasiado tarde, \u00bfverdad?", "tokens": [51664, 4686, 8483, 1573, 27367, 11, 3841, 331, 20034, 30, 51764], "temperature": 0.0, "avg_logprob": -0.15301106957828298, "compression_ratio": 1.4714828897338403, "no_speech_prob": 0.0037980189081281424}, {"id": 49, "seek": 18700, "start": 187.0, "end": 188.0, "text": " S\u00ed.", "tokens": [50364, 12375, 13, 50414], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 50, "seek": 18700, "start": 188.0, "end": 190.0, "text": " Demasiado tarde.", "tokens": [50414, 4686, 8483, 1573, 27367, 13, 50514], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 51, "seek": 18700, "start": 190.0, "end": 193.0, "text": " Tiene este muy abandonado en los campos, t\u00edo.", "tokens": [50514, 314, 10174, 4065, 5323, 9072, 1573, 465, 1750, 2255, 329, 11, 256, 20492, 13, 50664], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 52, "seek": 18700, "start": 193.0, "end": 194.0, "text": " Desde hace 20 a\u00f1os,", "tokens": [50664, 37985, 10032, 945, 11424, 11, 50714], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 53, "seek": 18700, "start": 194.0, "end": 196.0, "text": " las hierbas se han hecho duenas de todo.", "tokens": [50714, 2439, 3296, 16342, 369, 7276, 13064, 1581, 11581, 368, 5149, 13, 50814], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 54, "seek": 18700, "start": 196.0, "end": 199.0, "text": " Y en la casa, aparte del primer piso,", "tokens": [50814, 398, 465, 635, 9022, 11, 4936, 68, 1103, 12595, 280, 19227, 11, 50964], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 55, "seek": 18700, "start": 199.0, "end": 201.0, "text": " se reproducen muy bien las ara\u00f1as.", "tokens": [50964, 369, 11408, 13037, 5323, 3610, 2439, 15186, 32448, 13, 51064], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 56, "seek": 18700, "start": 201.0, "end": 203.0, "text": " Apenas algo al campo.", "tokens": [51064, 316, 5200, 296, 8655, 419, 29691, 13, 51164], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 57, "seek": 18700, "start": 203.0, "end": 205.0, "text": " Es verdad.", "tokens": [51164, 2313, 13692, 13, 51264], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 58, "seek": 18700, "start": 205.0, "end": 207.0, "text": " Y cuando sale, me hace soltar.", "tokens": [51264, 398, 7767, 8680, 11, 385, 10032, 1404, 23480, 13, 51364], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 59, "seek": 18700, "start": 207.0, "end": 209.0, "text": " Ven aqu\u00ed, perrito.", "tokens": [51364, 11182, 6661, 11, 680, 17492, 13, 51464], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 60, "seek": 18700, "start": 209.0, "end": 210.0, "text": " \u00bfQui\u00e9n es?", "tokens": [51464, 3841, 48, 3077, 3516, 785, 30, 51514], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 61, "seek": 18700, "start": 210.0, "end": 212.0, "text": " Es la hija de Ramona, mis silbientas.", "tokens": [51514, 2313, 635, 10625, 64, 368, 9078, 4037, 11, 3346, 3425, 65, 1196, 296, 13, 51614], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 62, "seek": 18700, "start": 212.0, "end": 213.0, "text": " \u00a1Denga!", "tokens": [51614, 6514, 35, 31494, 0, 51664], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 63, "seek": 18700, "start": 213.0, "end": 215.0, "text": " Est\u00e1 hecha una salvaje.", "tokens": [51664, 27304, 415, 4413, 2002, 26858, 11153, 13, 51764], "temperature": 0.0, "avg_logprob": -0.19200023233074032, "compression_ratio": 1.4291187739463602, "no_speech_prob": 0.0023532600607722998}, {"id": 64, "seek": 21500, "start": 216.0, "end": 218.0, "text": " \u00bfC\u00f3mo te parece esa tu t\u00eda?", "tokens": [50414, 3841, 28342, 535, 14120, 11342, 2604, 256, 2686, 30, 50514], "temperature": 0.0, "avg_logprob": -0.1707327461242676, "compression_ratio": 1.1074380165289257, "no_speech_prob": 0.004364877473562956}, {"id": 65, "seek": 21500, "start": 218.0, "end": 220.0, "text": " Hasta el mismo modo de andar.", "tokens": [50514, 45027, 806, 12461, 16664, 368, 50009, 13, 50614], "temperature": 0.0, "avg_logprob": -0.1707327461242676, "compression_ratio": 1.1074380165289257, "no_speech_prob": 0.004364877473562956}, {"id": 66, "seek": 21500, "start": 220.0, "end": 222.0, "text": " Ya lo s\u00e9, t\u00edo.", "tokens": [50614, 6080, 450, 7910, 11, 256, 20492, 13, 50714], "temperature": 0.0, "avg_logprob": -0.1707327461242676, "compression_ratio": 1.1074380165289257, "no_speech_prob": 0.004364877473562956}, {"id": 67, "seek": 21500, "start": 222.0, "end": 223.0, "text": " Ya me lo ha dicho este antes.", "tokens": [50714, 6080, 385, 450, 324, 27346, 4065, 11014, 13, 50764], "temperature": 0.0, "avg_logprob": -0.1707327461242676, "compression_ratio": 1.1074380165289257, "no_speech_prob": 0.004364877473562956}, {"id": 68, "seek": 21500, "start": 223.0, "end": 225.0, "text": " Lo ves, y la voz tambi\u00e9n.", "tokens": [50764, 6130, 28274, 11, 288, 635, 30005, 6407, 13, 50864], "temperature": 0.0, "avg_logprob": -0.1707327461242676, "compression_ratio": 1.1074380165289257, "no_speech_prob": 0.004364877473562956}, {"id": 69, "seek": 24500, "start": 245.0, "end": 247.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50364, 3841, 15137, 20260, 30, 50464], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 70, "seek": 24500, "start": 247.0, "end": 248.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50464, 3841, 15137, 20260, 30, 50514], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 71, "seek": 24500, "start": 248.0, "end": 249.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50514, 3841, 15137, 20260, 30, 50564], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 72, "seek": 24500, "start": 249.0, "end": 250.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50564, 3841, 15137, 20260, 30, 50614], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 73, "seek": 24500, "start": 250.0, "end": 251.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50614, 3841, 15137, 20260, 30, 50664], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 74, "seek": 24500, "start": 251.0, "end": 252.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50664, 3841, 15137, 20260, 30, 50714], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "compression_ratio": 13.461538461538462, "no_speech_prob": 0.8573354482650757}, {"id": 75, "seek": 24500, "start": 252.0, "end": 253.0, "text": " \u00bfQu\u00e9 pasa?", "tokens": [50714, 3841, 15137, 20260, 30, 50764], "temperature": 0.0, "avg_logprob": -0.1592700539565668, "