ssion_ratio": 1.320754716981132, "no_speech_prob": 0.003056054702028632}, {"id": 42, "seek": 21300, "start": 238.0, "end": 240.0, "text": " Oh, mucho gusto.", "tokens": [51614, 876, 11, 9824, 38723, 13, 51714], "temperature": 0.0, "avg_logprob": -0.36091189664952894, "compression_ratio": 1.320754716981132, "no_speech_prob": 0.003056054702028632}, {"id": 43, "seek": 24000, "start": 241.0, "end": 243.0, "text": " \u00bfC\u00f3mo est\u00e1 t\u00edo?", "tokens": [50414, 3841, 28342, 3192, 256, 20492, 30, 50514], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 44, "seek": 24000, "start": 243.0, "end": 245.0, "text": " Bien, bien.", "tokens": [50514, 16956, 11, 3610, 13, 50614], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 45, "seek": 24000, "start": 245.0, "end": 247.0, "text": " Yo gola a tu busco en retraso, \u00bfverdad?", "tokens": [50614, 7616, 352, 875, 257, 2604, 1255, 1291, 465, 1533, 3906, 78, 11, 3841, 331, 20034, 30, 50714], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 46, "seek": 24000, "start": 247.0, "end": 248.0, "text": " \u00bfQu\u00e9 tal el viaje?", "tokens": [50714, 3841, 15137, 4023, 806, 48932, 30, 50764], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 47, "seek": 24000, "start": 248.0, "end": 249.0, "text": " Muy bueno.", "tokens": [50764, 39586, 11974, 13, 50814], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 48, "seek": 24000, "start": 249.0, "end": 251.0, "text": " Qu\u00e9 bonito si t\u00edo.", "tokens": [50814, 23662, 31209, 1511, 256, 20492, 13, 50914], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 49, "seek": 24000, "start": 251.0, "end": 252.0, "text": " Muy tranquilo.", "tokens": [50914, 39586, 17640, 10720, 13, 50964], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 50, "seek": 24000, "start": 252.0, "end": 254.0, "text": " Yo voy a aparecer que sigues en el convento.", "tokens": [50964, 7616, 7552, 257, 43336, 631, 4556, 1247, 465, 806, 416, 2475, 78, 13, 51064], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 51, "seek": 24000, "start": 254.0, "end": 255.0, "text": " Bueno.", "tokens": [51064, 16046, 13, 51114], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 52, "seek": 24000, "start": 255.0, "end": 257.0, "text": " Panto te vas a aquelar.", "tokens": [51114, 430, 5857, 535, 11481, 257, 2373, 338, 289, 13, 51214], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 53, "seek": 24000, "start": 257.0, "end": 259.0, "text": " Muy poco t\u00edo.", "tokens": [51214, 39586, 10639, 256, 20492, 13, 51314], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 54, "seek": 24000, "start": 259.0, "end": 261.0, "text": " Solo tengo permiso para unos d\u00edas.", "tokens": [51314, 26452, 13989, 4784, 19227, 1690, 17780, 19527, 13, 51414], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 55, "seek": 24000, "start": 261.0, "end": 263.0, "text": " Te costo mucho conseguirlo.", "tokens": [51414, 1989, 2063, 78, 9824, 21229, 752, 13, 51514], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 56, "seek": 24000, "start": 263.0, "end": 264.0, "text": " No.", "tokens": [51514, 883, 13, 51564], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 57, "seek": 24000, "start": 264.0, "end": 267.0, "text": " Viene por orden de la superior.", "tokens": [51564, 691, 10174, 1515, 28615, 368, 635, 13028, 13, 51714], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 58, "seek": 24000, "start": 267.0, "end": 268.0, "text": " No.", "tokens": [51714, 883, 13, 51764], "temperature": 0.0, "avg_logprob": -0.38289085670753764, "compression_ratio": 1.4135021097046414, "no_speech_prob": 0.11378873139619827}, {"id": 59, "seek": 26800, "start": 268.0, "end": 270.0, "text": " Viene por orden de la superior.", "tokens": [50364, 691, 10174, 1515, 28615, 368, 635, 13028, 13, 50464], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 60, "seek": 26800, "start": 270.0, "end": 274.0, "text": " Tampoco te interesaba verme que te lo tuvieron que ordenar.", "tokens": [50464, 314, 1215, 11198, 535, 20157, 5509, 1306, 1398, 631, 535, 450, 38177, 14440, 631, 28615, 289, 13, 50664], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 61, "seek": 26800, "start": 274.0, "end": 277.0, "text": " La verdad, no mucho.", "tokens": [50664, 2369, 13692, 11, 572, 9824, 13, 50814], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 62, "seek": 26800, "start": 277.0, "end": 279.0, "text": " Yo no se mentir t\u00edo.", "tokens": [50814, 7616, 572, 369, 3074, 347, 256, 20492, 13, 50914], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 63, "seek": 26800, "start": 279.0, "end": 282.0, "text": " Le tengo respeto y agradecimiento porque en lo material se lo dibot\u00f3.", "tokens": [50914, 1456, 13989, 1597, 19515, 288, 31469, 66, 14007, 4021, 465, 450, 2527, 369, 450, 23064, 310, 812, 13, 51064], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 64, "seek": 26800, "start": 282.0, "end": 284.0, "text": " Pero no dem\u00e1s.", "tokens": [51064, 9377, 572, 34682, 13, 51164], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 65, "seek": 26800, "start": 284.0, "end": 285.0, "text": " Ning\u00fan calor es malo.", "tokens": [51164, 39417, 9453, 31575, 785, 2806, 78, 13, 51214], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 66, "seek": 26800, "start": 285.0, "end": 287.0, "text": " Ning\u00fan.", "tokens": [51214, 39417, 9453, 13, 51314], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 67, "seek": 26800, "start": 287.0, "end": 288.0, "text": " Tiene raz\u00f3n.", "tokens": [51314, 314, 10174, 38310, 13, 51364], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 68, "seek": 26800, "start": 288.0, "end": 290.0, "text": " La soledad me ha vuelto egoista.", "tokens": [51364, 2369, 1404, 292, 345, 385, 324, 20126, 1353, 14495, 5236, 13, 51464], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 69, "seek": 26800, "start": 290.0, "end": 293.0, "text": " Ahora siento que no hayamos tenido m\u00e1s trato.", "tokens": [51464, 18840, 40340, 631, 572, 4842, 2151, 33104, 3573, 504, 2513, 13, 51614], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 70, "seek": 26800, "start": 293.0, "end": 294.0, "text": " De m\u00e1s yado tarde.", "tokens": [51614, 1346, 3573, 288, 1573, 27367, 13, 51664], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 71, "seek": 26800, "start": 294.0, "end": 295.0, "text": " Perd\u00e1.", "tokens": [51664, 47633, 842, 13, 51714], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 72, "seek": 26800, "start": 295.0, "end": 296.0, "text": " S\u00ed.", "tokens": [51714, 12375, 13, 51764], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 73, "seek": 26800, "start": 296.0, "end": 297.0, "text": " De m\u00e1s yado tarde.", "tokens": [51764, 1346, 3573, 288, 1573, 27367, 13, 51814], "temperature": 0.0, "avg_logprob": -0.2865509137715379, "compression_ratio": 1.556420233463035, "no_speech_prob": 0.005212971940636635}, {"id": 74, "seek": 29700, "start": 298.0, "end": 300.0, "text": " Tiene muy abandonados los campos.", "tokens": [50414, 314, 10174, 5323, 9072, 4181, 1750, 2255, 329, 13, 50514], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 75, "seek": 29700, "start": 300.0, "end": 303.0, "text": " Desde hace 20 a\u00f1os las hierbas se han hecho due\u00f1as.", "tokens": [50514, 37985, 10032, 945, 11424, 2439, 3296, 16342, 369, 7276, 13064, 3462, 32448, 13, 50664], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 76, "seek": 29700, "start": 303.0, "end": 306.0, "text": " Y en la casa, a parte del primer piso,", "tokens": [50664, 398, 465, 635, 9022, 11, 257, 6975, 1103, 12595, 280, 19227, 11, 50814], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 77, "seek": 29700, "start": 306.0, "end": 309.0, "text": " se reproducen muy bien las ara\u00f1as.", "tokens": [50814, 369, 11408, 13037, 5323, 3610, 2439, 15186, 32448, 13, 50964], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 78, "seek": 29700, "start": 309.0, "end": 311.0, "text": " Apenas al cual campo.", "tokens": [50964, 316, 5200, 296, 419, 10911, 29691, 13, 51064], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 79, "seek": 29700, "start": 311.0, "end": 312.0, "text": " Es verdad.", "tokens": [51064, 2313, 13692, 13, 51114], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 80, "seek": 29700, "start": 312.0, "end": 314.0, "text": " Y cuando sale mi atesa est\u00e1.", "tokens": [51114, 398, 7767, 8680, 2752, 412, 13708, 3192, 13, 51214], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 81, "seek": 29700, "start": 314.0, "end": 316.0, "text": " Ven aqu\u00ed perrito.", "tokens": [51214, 11182, 6661, 680, 17492, 13, 51314], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 82, "seek": 29700, "start": 316.0, "end": 318.0, "text": " \u00bfQui\u00e9n es?", "tokens": [51314, 3841, 48, 3077, 3516, 785, 30, 51414], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 83, "seek": 29700, "start": 318.0, "end": 320.0, "text": " Es la hija de Ramona, miservienta.", "tokens": [51414, 2313, 635, 10625, 64, 368, 9078, 4037, 11, 3346, 1978, 1196, 64, 13, 51514], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 84, "seek": 29700, "start": 320.0, "end": 321.0, "text": " Venga.", "tokens": [51514, 691, 31494, 13, 51564], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 85, "seek": 29700, "start": 321.0, "end": 323.0, "text": " Est\u00e1 hecho una salvaje.", "tokens": [51564, 27304, 13064, 2002, 26858, 11153, 13, 51664], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 86, "seek": 29700, "start": 323.0, "end": 326.0, "text": " \u00bfC\u00f3mo te parece esa tu t\u00eda?", "tokens": [51664, 3841, 28342, 535, 14120, 11342, 2604, 256, 2686, 30, 51814], "temperature": 0.0, "avg_logprob": -0.36110279578289, "compression_ratio": 1.42, "no_speech_prob": 0.01753363013267517}, {"id": 87, "seek": 32600, "start": 326.0, "end": 328.0, "text": " Hasta el mismo modo de andar.", "tokens": [50364, 45027, 806, 12461, 16664, 368, 50009, 13, 50464], "temperature": 0.0, "avg_logprob": -0.4074847148014949, "compression_ratio": 1.092783505154639, "no_speech_prob": 0.0063491263426840305}, {"id": 88, "seek": 32600, "start": 328.0, "end": 330.0, "text": " Ya lo s\u00e9, tio.", "tokens": [50464, 6080, 450, 7910, 11, 44735, 13, 50564], "temperature": 0.0, "avg_logprob": -0.4074847148014949, "compression_ratio": 1.092783505154639, "no_speech_prob": 0.0063491263426840305}, {"id": 89, "seek": 32600, "start": 330.0, "end": 331.0, "text": " Y