# Copy to .env and fill in values

# Postgres connection string. Required for `prisma generate` / Prisma CLI (prisma.config.ts) and at runtime.
# On Vercel, add DATABASE_URL to the project Environment Variables for Preview + Production (build uses it).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (safe to expose to the browser). This app uses hosted Checkout via API routes, so this is optional unless you add Stripe.js / Elements on the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price ID for $5/month product (create in Stripe Dashboard — must match app copy)
STRIPE_PRICE_ID=

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra emails with full catalog (comma-separated), in addition to the built-in maintainer dev account.
DEV_UNLIMITED_EMAILS=

# OpenAI (optional): server-side Whisper for POST /api/asr/transcribe — never expose to the client.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
