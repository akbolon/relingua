        {
          "t": "Hermana,",
          "en": "Sister — religious title for a nun (here, addressing you).",
          "pron": "air-MAH-nah; stress on -MAH-. (Spain: light /h/; Americas: often silent.)"
        },
        {
          "t": "Viridiana.",
          "en": "Viridiana — the novice’s name.",
          "pron": "vee-ree-DYAH-nah; stress on -DYAH- (Spain: bee- with soft b/v)."
        }
      ]
    },
    {
      "start": 120.72,
      "end": 121.17,
      "words": [
        {
          "t": "La caridad que practicamos aquí",
