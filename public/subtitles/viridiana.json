      "end": 124.25,
      "words": [
        {
          "t": "Antes de profesar,",
          "en": "Before you take (religious) vows / before professing",
          "pron": "AHN-tes deh proh-feh-SAHR; stress -SAHR; pause after comma."
        },
        {
          "t": "quiero que cumplas",
          "en": "I want you to fulfill (subjunctive)",
          "pron": "KYEH-roh keh KOOM-plahs; stress KOOM- (subjunctive)."
        },
        {
          "t": "una última misión de caridad.",
          "en": "one last mission of charity.",
          "pron": "OOL-tee-mah mee-syOHN … kah-ree-DAHD; stress syOHN."
        }
      ]
    },
    {
      "start": 124.58,
      "end": 124.96,
      "words": [
        {
          "t": "Debes ir a la finca",
