  "cues": [
    {
      "start": 119.5,
      "end": 126.5,
      "enLine": "Sister Viridiana.",
      "words": [
        {
          "t": "Hermana,",
          "en": "Sister (title) · [air-MAH-nah]"
        },
        {
          "t": "Viridiana.",
          "en": "Her name · [vee-ree-dee-AH-nah]"
        }
      ]
    },
    {
      "start": 126.5,
      "end": 135.94,
      "enLine": "The charity we practice here must not be merely abstract.",
      "words": [
        {
          "t": "La caridad que practicamos aquí",
          "en": "The charity we practice here · [kah-ree-DAHD … ah-KEE]"
        },
        {
          "t": "no debe ser",
          "en": "must not be · [noh DEH-beh sehr]"
        },
        {
          "t": "solo abstracta.",
          "en": "only abstract · [SOH-loh ahb-STRAHK-tah]"
        }
      ]
    },
    {
      "start": 136.44,
      "end": 146.67,
      "enLine": "Before you take your vows, I want you to fulfill one last mission of charity.",
      "words": [
        {
          "t": "Antes de profesar,",
          "en": "Before taking vows · [AHN-tes de proh-feh-SAHR]"
        },
        {
          "t": "quiero que cumplas",
          "en": "I want you to fulfill · [KYEH-roh keh KOOM-plahs]"
        },
        {
          "t": "una última misión de caridad.",
          "en": "one last mission of charity · [mee-SYOHN]"
        }
      ]
    },
    {
      "start": 147,
      "end": 155.72,
      "enLine": "You must go to your uncle Don Jaime’s country estate.",
      "words": [
        {
          "t": "Debes ir a la finca",
          "en": "You must go to the estate · [DEH-bes eer ah lah FEEN-kah]"
        },
        {
          "t": "de tu tío don Jaime.",
          "en": "of your uncle Don Jaime · [too TEE-oh dohn HY-meh]"
        }
      ]
    },
    {
      "start": 157.57,
      "end": 167.19,
      "enLine": "Your uncle has asked you to come before you take your vows — so he can see you before you profess.",
      "words": [
        {
          "t": "Él te ha pedido",
          "en": "He has asked you · [ehl teh ah peh-DEE-doh]"
        },
        {
          "t": "que vayas antes de tomar los votos.",
          "en": "to come before you take your vows · [keh BAH-yahs AHN-tes de toh-MAHR lohs BOH-tohs]"
        }
      ]
    },
    {
      "start": 168.04,
      "end": 173.23,
      "enLine": "I don’t want to see him, Mother.",
      "words": [
        {
          "t": "No quiero verlo,",
          "en": "I don’t want to see him · [noh KYEH-roh BEHR-loh]"
        },
        {
          "t": "madre.",
          "en": "Mother (superior) · [MAH-dreh]"
        }
      ]
    },
    {
      "start": 174.08,
      "end": 181.65,
      "enLine": "It is an act of humility and of forgiveness.",
      "words": [
        {
          "t": "Es un acto de humildad",
          "en": "It is an act of humility · [ehs oon AHK-toh de oo-meel-DAHD]"
        },
        {
          "t": "y de perdón.",
          "en": "and of pardon · [ee de pehr-DOHN]"
        }
      ]
    },
    {
      "start": 183.5,
      "end": 191.26,
      "enLine": "Your uncle is alone and ill with longing.",
      "words": [
        {
          "t": "Tu tío está solo",
          "en": "Your uncle is alone · [too TEE-oh ehs-TAH SOH-loh]"
        },
        {
          "t": "y enfermo de nostalgia.",
          "en": "and sick with nostalgia · [ehn-FEHR-moh de nohs-tahl-HEE-ah]"
        }
      ]
    },
    {
